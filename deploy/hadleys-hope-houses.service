[Unit]
Description=Hadley's Hope house controllers (stand-in runtime over MQTT)
After=network.target mosquitto.service hadleys-hope.service

[Service]
User=hh
WorkingDirectory=/opt/hadleys-hope
Environment=MQTT_URL=localhost:1883
ExecStart=/opt/hadleys-hope/venv/bin/python3 /opt/hadleys-hope/houses_runtime.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
